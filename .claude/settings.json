{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/session-start.js",
            "timeout": 5
          }
        ],
        "description": "Load previous session context, detect project stack and package manager"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/orchestration-preflight.js",
            "timeout": 300
          }
        ],
        "description": "Orchestration preflight — repo sync, routing, persona resolution, memory alignment, and weekly-log freshness before governed execution"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/branch-protection.js",
            "timeout": 5
          }
        ],
        "description": "Branch protection — blocks edits on main/master branch"
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/doc-guard.js",
            "timeout": 5
          }
        ],
        "description": "Doc proliferation guard — blocks creation of random .md files outside sanctioned paths"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/pre-push-reminder.js",
            "timeout": 300
          }
        ],
        "description": "Pre-push sync guard — enforces Master.Prompt + Master.Doc sync/commit/push before app git push"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/suggest-compact.js",
            "timeout": 5
          }
        ],
        "description": "Strategic compaction — suggests /compact at logical breakpoints (every 30 edits)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/orchestration-post-acceptance.js",
            "timeout": 300
          }
        ],
        "description": "Post-acceptance sync — records successful git pushes into Master.Doc via weekly logs and shared-memory promotion"
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/auto-format-js.js",
            "timeout": 30
          }
        ],
        "description": "Auto-format JS/TS — runs Prettier on .js/.jsx/.ts/.tsx files after edits"
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/auto-format-php.js",
            "timeout": 30
          }
        ],
        "description": "Auto-format PHP — runs Laravel Pint or php-cs-fixer on .php files after edits"
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/auto-install-deps.js",
            "timeout": 60
          }
        ],
        "description": "Auto-install deps — detects PM (npm/yarn/pnpm/bun/composer/go) and runs install when dependency files change"
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/auto-run-tests.js",
            "timeout": 90
          }
        ],
        "description": "Auto-run tests — runs Jest/PHPUnit/Pest when test files change"
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/type-check-ts.js",
            "timeout": 30
          }
        ],
        "description": "TypeScript type-check — runs tsc --noEmit on .ts/.tsx files (non-blocking)"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/pre-compact.js",
            "timeout": 5
          }
        ],
        "description": "Save state before compaction — preserves modified files and TODOs"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/stop-checks.js",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/prompt-completion-memory-status.js",
            "timeout": 45
          }
        ],
        "description": "Final verification and memory status — checks modified files, warms shared memory, and surfaces promotion backlog"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../Master.Prompt/.claude/scripts/hooks/session-end.js",
            "timeout": 5
          }
        ],
        "description": "Persist session state — saves modified files, duration, and context for next session"
      }
    ]
  },
  "env": {
    "INSIDE_CLAUDE_CODE": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "420000",
    "BASH_MAX_TIMEOUT_MS": "420000",
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "MASTER_PROMPT_HOOK_PROFILE": "standard"
  }
}
